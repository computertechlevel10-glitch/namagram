    <!-- Rules Screen Strings -->
    <string name="rules_header">📖 RULES OF THE GAME</string>
    <string name="rule_1"><![CDATA[1. The sentence <font color="#EF4444"><b>must</b></font> make sense, both grammatically and in the general sense of the English language. So start your sentence with a capital letter, and end with a terminal mark (. ! ?).]]></string>
    <string name="rule_2"><![CDATA[2. Every word in the sentence <font color="#EF4444"><b>must</b></font> start with one of your available letter sequence tiles. Tiles can be used in any order, but using them <font color="#EF4444"><b>all</b></font> in exact sequence awards maximum points!]]></string>
    <string name="rule_3"><![CDATA[3. Only <font color="#EF4444"><b>one</b></font> comma is allowed per sentence, and the sentence must end with a <font color="#EF4444"><b>single</b></font> terminal mark (. ! ?). No multi-sentence submissions.]]></string>
    <string name="rule_4"><![CDATA[4. The sentence must be <font color="#EF4444"><b>one</b></font> complete sentence, (no full stops to abut two sentences together). Incomplete sentences will <font color="#EF4444"><b>not</b></font> score points.]]></string>
    <string name="rule_5"><![CDATA[5. The same word cannot be used more than <font color="#EF4444"><b>twice</b></font> in the sentence.]]></string>
    <string name="rule_6"><![CDATA[6. Sentences <font color="#EF4444"><b>must</b></font> maintain a consistent verb tense, use clear pronouns, and contain at <font color="#EF4444"><b>most</b></font> one proper/personal name.]]></string>
    <string name="rule_7"><![CDATA[7. <font color="#EF4444"><b>No</b></font> slang or swear words are allowed.]]></string>
    <string name="rule_8"><![CDATA[8. Inverted commas are allowed <font color="#EF4444"><b>if</b></font> the sentence calls for them.]]></string>
    <string name="rules_section_header">📜 GAME RULES</string>
    <string name="rule_numbered_item">%1$d. %2$s</string>

